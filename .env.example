# Application
APP_ENV=development
TZ=Europe/London

# Trading 212 — use READ-ONLY API credentials only
TRADING212_ENV=demo
TRADING212_API_KEY=
TRADING212_API_SECRET=

# Optional market-data fallback. Yahoo is the primary provider.
TWELVE_DATA_API_KEY=

# Optional AI review. Keep disabled unless you configure a provider.
AI_PROVIDER=disabled
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local persistence
DATABASE_URL=sqlite:///./portfolio_monitor.db

# Protects POST /admin/run-scan. Generate with:
# portfolio-monitor generate-admin-token
ADMIN_TOKEN=

# V1 is advisory only. Keep true.
DRY_RUN=true

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_MINUTE=5
SCHEDULER_TEST_INTERVAL_SECONDS=0
